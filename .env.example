# CSI (RCSI) — copy to .env and set password locally (do not commit .env)

# Optional; if unset, defaults in config/csi.ts apply
CSI_BASE_URL=""
CSI_TEST_EMAIL=""
CSI_TEST_PASSWORD=""

# Org admin (Account Management — user list / add user, AB-019)
CSI_ORG_TEST_EMAIL=""
CSI_ORG_TEST_PASSWORD=""

# Org user — must exist under org domain; AM-050 deactivates then reactivates this account (keep Active when not running the test)
CSI_ORG_USER_TEST_EMAIL=""
CSI_ORG_USER_TEST_PASSWORD=""

# TR-022 — org user with auto-assigned course(s) on My Course
CSI_AUTO_ENROLL_ORG_USER_TEST_EMAIL=""
CSI_AUTO_ENROLL_ORG_USER_TEST_PASSWORD=""

# TR-010 — user with passed course certificate on My Course
CSI_TEST_PASSING_USER_TEST_EMAIL=""
CSI_TEST_PASSING_USER_TEST_PASSWORD=""

# Training admin (TR-001 — course distribution)
CSI_TRAINING_ADMIN_TEST_EMAIL=""
CSI_TRAINING_ADMIN_TEST_PASSWORD=""

# TR-011 — My Course fail/retake (course name; keep Introduction to Cybersecurity for test env)
CSI_TRAINING_FAIL_RETAKE_COURSE_NAME="Introduction to Cybersecurity"

# Phising admin (PH-001 — phishing test creation)
CSI_PHISING_ADMIN_TEST_EMAIL=""
CSI_PHISING_ADMIN_TEST_PASSWORD=""

# CC-001 — Training + Phishing package tenant admins
CSI_TP_TRAINING_ADMIN_TEST_EMAIL=""
CSI_TP_TRAINING_ADMIN_TEST_PASSWORD=""
CSI_TP_PHISING_ADMIN_TEST_EMAIL=""
CSI_TP_PHISING_ADMIN_TEST_PASSWORD=""

# Incident reporter (IR-005 / IR-001 / IR-011 / AM-045 — MFA verification user)
CSI_INCIDENT_REPORTER_TEST_EMAIL=""
CSI_INCIDENT_REPORTER_TEST_PASSWORD=""
# IR-011: display name as shown in handler search list (default sun wong)
CSI_INCIDENT_HANDLER_DISPLAY_NAME=""

# System owner (IR-001 — user list roles; AM-045 — org MFA settings)
CSI_SYSTEM_OWNER_TEST_EMAIL=""
CSI_SYSTEM_OWNER_TEST_PASSWORD=""

# AM-063 / PM-031 / IA-048 / SR-009 — Org A / Org B system owners (isolation tests)
CSI_ORG_A_SYSTEM_OWNER_TEST_EMAIL=""
CSI_ORG_A_SYSTEM_OWNER_TEST_PASSWORD=""
CSI_ORG_B_SYSTEM_OWNER_TEST_EMAIL=""
CSI_ORG_B_SYSTEM_OWNER_TEST_PASSWORD=""

# IR-019 — Org A / Org B incident reporters (isolation; env key spelling INCIDNET matches recorded steps)
CSI_ORG_A_INCIDNET_REPORTER_TEST_EMAIL=""
CSI_ORG_A_INCIDNET_REPORTER_TEST_PASSWORD=""
CSI_ORG_B_INCIDNET_REPORTER_TEST_EMAIL=""
CSI_ORG_B_INCIDNET_REPORTER_TEST_PASSWORD=""

# SR-005 — Attack Surface: admin who can Request New Report (then CSI_TEST approves pending row)
CSI_SECURITY_REPORT_ADMIN_EMAIL=""
CSI_SECURITY_REPORT_ADMIN_PASSWORD=""

# SB-056 — restricted module access (Training, Phishing, Account Management; no Sales & Billing, etc.)
CSI_TRAINING_PHISING_SYS_OWNER_TEST_EMAIL=""
CSI_TRAINING_PHISING_SYS_OWNER_TEST_PASSWORD=""

# CC-023 — expired sales system owner (revoked hub modules after login)
CSI_EXPIRED_SALES_SYSTEM_OWNER_TEST_EMAIL=""
CSI_EXPIRED_SALES_SYSTEM_OWNER_TEST_PASSWORD=""

# CC-022 — system owner without Policy Management until sales order is updated
CSI_NO_POLICY_SYSTEM_OWNER_TEST_EMAIL=""
CSI_NO_POLICY_SYSTEM_OWNER_TEST_PASSWORD=""

# PT-001 / CI-001 / IR-016 — penetration tester (Penetration Test, Cyber Insurance, Incident Response SSO)
CSI_PENETRATION_TESTER_TEST_EMAIL=""
CSI_PENETRATION_TESTER_TEST_PASSWORD=""

CI="1"
