CSI_AVOTECH_MANAGER_TEST_PASSWORD=""

# IA-008 — system owner who adds / manages client machine assets under IT Asset Management
CSI_IT_ASSET_MANAGER_TEST_EMAIL=""
CSI_IT_ASSET_MANAGER_TEST_PASSWORD=""

# AM-041 — system owner creates group + assigns manager
# CSI_GROUP_MANAGER_NAME: display name used to search for the manager in the group creation form (e.g. "Dax Manning12")
CSI_GROUP_MANAGER_NAME=""
# CSI_GROUP_MANAGER_EMAIL / PASSWORD: credentials for the second login to verify group visibility
CSI_GROUP_MANAGER_EMAIL=""
CSI_GROUP_MANAGER_PASSWORD=""
# CSI_GROUP_MEMBER_EMAIL: email of the user to be added as a member of the new group
CSI_GROUP_MEMBER_EMAIL=""
CSI_GROUP_MEMBER_PASSWORD=""

# Org user — must exist under org domain; AM-050 deactivates then reactivates this account (keep Active when not running the test)
CSI_ORG_USER_TEST_EMAIL=""
CSI_ORG_USER_TEST_PASSWORD=""

