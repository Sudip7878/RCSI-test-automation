# CSI (RCSI) — copy to .env and set password locally (do not commit .env)

# Optional; if unset, defaults in config/csi.ts apply
CSI_BASE_URL=""
CSI_TEST_EMAIL=""
CSI_TEST_PASSWORD=""

# Org admin (Account Management — user list / add user, AM-019)
CSI_ORG_TEST_EMAIL=""
CSI_ORG_TEST_PASSWORD=""

# AM-020 — admin user who adds a user to any org (super admin / platform admin role)
CSI_ADMIN_TEST_EMAIL=""
CSI_ADMIN_TEST_PASSWORD=""

# CC-013 — Admin user whose Admin role is revoked and restored on an open session
# (second browser logs in as CSI_TEST_EMAIL). Account must start with the Admin role assigned.
CSI_ADMIN_USER_TEST_EMAIL=""
CSI_ADMIN_USER_TEST_PASSWORD=""

# AM-021 — Avotech org manager; verifies that the super-admin-created user appears in the user list
